<Window x:Class="TaskbarDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:TaskbarDock.Icons"
        Title="任务栏整合 · 设置"
        Width="780" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Br.Fg}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Br.Fg}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" MouseLeftButtonDown="OnWindowDrag">
    <Border Margin="12" CornerRadius="12"
            Background="{DynamicResource Br.Menu}"
            BorderBrush="{DynamicResource Br.Border}"
            BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.42"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Padding="18,14,12,12" MouseLeftButtonDown="OnDragMove">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="任务栏整合" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Br.Fg}"/>
                        <TextBlock Text="· 设置" FontSize="15" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Br.Fg2}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="36" Height="28" Padding="0"
                            Style="{StaticResource FlatButton}"
                            FontFamily="Segoe Fluent Icons" FontSize="11"
                            Content="&#xE8BB;" Click="OnClose" ToolTip="关闭"/>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Style="{StaticResource CleanTab}"
                        ItemContainerStyle="{StaticResource CleanTabItem}" Margin="14,0">

                <!-- 分组 -->
                <TabItem Header="分组">
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="添加" Style="{StaticResource FlatButton}" Padding="12,5" Click="OnAddGroup"/>
                                <Button Content="删除" Style="{StaticResource FlatButton}" Padding="12,5" Margin="8,0,0,0" Click="OnDelGroup"/>
                            </StackPanel>
                            <Border CornerRadius="8" Background="{DynamicResource Br.Hover}" Padding="4">
                                <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="OnGroupSelected"/>
                            </Border>
                        </DockPanel>

                        <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Detail" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="分组名称" Style="{StaticResource Label}" Margin="0,10"/>
                                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,6" TextChanged="OnNameChanged"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="快捷方式目录" Style="{StaticResource Label}" Margin="0,10"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FolderBox" TextChanged="OnFolderChanged"/>
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Padding="12,5" Click="OnBrowseFolder"/>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="图标样式" Style="{StaticResource Label}" Margin="0,10"/>
                                    <ComboBox x:Name="PackCombo" Grid.Row="2" Grid.Column="1" Margin="0,6"
                                              SelectionChanged="OnPackChanged"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="图标" Style="{StaticResource Label}" Margin="0,10" VerticalAlignment="Top"/>
                                    <WrapPanel x:Name="IconGrid" Grid.Row="3" Grid.Column="1" Margin="0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="自定义图标" Style="{StaticResource Label}" Margin="0,10"/>
                                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CustomIconBox" TextChanged="OnCustomIconChanged"/>
                                        <Button Grid.Column="1" Content="选择文件…" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Padding="12,5" Click="OnBrowseIcon"/>
                                        <Button Grid.Column="2" Content="清除" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Padding="12,5" Click="OnClearIcon"/>
                                    </Grid>

                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,0,0"
                                               Style="{StaticResource SubLabel}"
                                               Text="把程序的快捷方式放进目录，菜单里就会自动出现；按住菜单项可拖动排序。"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- 外观 -->
                <TabItem Header="外观">
                    <ScrollViewer Margin="0,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" Style="{StaticResource Label}" Margin="0,8"/>
                                <ComboBox x:Name="ThemeCombo" Grid.Row="0" Grid.Column="1" Margin="0,6">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色" Tag="Light"/>
                                    <ComboBoxItem Content="深色" Tag="Dark"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="材质" Style="{StaticResource Label}" Margin="0,8"/>
                                <CheckBox x:Name="AcrylicCheck" Grid.Row="1" Grid.Column="1" Margin="0,8"
                                          Content="使用亚克力半透明背景（与 Windows 11 任务栏一致）"
                                          Checked="OnVisualChanged" Unchecked="OnVisualChanged"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="任务栏图标" Style="{StaticResource Label}" Margin="0,8"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                    <Button Content="立即重建" Style="{StaticResource FlatButton}" Padding="12,5" Click="OnRebuildIcons"/>
                                    <TextBlock Margin="12,0,0,0" Style="{StaticResource SubLabel}" VerticalAlignment="Center"
                                               Text="右键任务栏图标可「固定到任务栏 / 从任务栏取消固定」"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="图标大小" Style="{StaticResource Label}" Margin="0,8"/>
                                <TextBox x:Name="IconSizeBox" Grid.Row="3" Grid.Column="1" Margin="0,6" Width="120" HorizontalAlignment="Left" TextChanged="OnVisualChanged"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="菜单最大宽度" Style="{StaticResource Label}" Margin="0,8"/>
                                <TextBox x:Name="MenuWidthBox" Grid.Row="4" Grid.Column="1" Margin="0,6" Width="120" HorizontalAlignment="Left" TextChanged="OnVisualChanged"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="菜单最大高度" Style="{StaticResource Label}" Margin="0,8"/>
                                <TextBox x:Name="MenuHeightBox" Grid.Row="5" Grid.Column="1" Margin="0,6" Width="120" HorizontalAlignment="Left" TextChanged="OnVisualChanged"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="菜单项图标" Style="{StaticResource Label}" Margin="0,8"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                    <CheckBox x:Name="ShowIconsCheck" Content="显示程序图标"
                                              Checked="OnVisualChanged" Unchecked="OnVisualChanged"/>
                                    <TextBox x:Name="ItemIconSizeBox" Width="80" Margin="16,0,0,0" TextChanged="OnVisualChanged"/>
                                    <TextBlock Text="px" Style="{StaticResource SubLabel}" Margin="6,0,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource SubLabel}"
                                           Text="外观修改会立即生效。"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 常规 -->
                <TabItem Header="常规">
                    <StackPanel Margin="0,14">
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,8" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged"/>
                        <CheckBox x:Name="TrayCheck" Content="在系统托盘显示图标（右键可打开设置）" Margin="0,8" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged"/>

                        <TextBlock Margin="0,20,0,4" Style="{StaticResource Label}" Text="配置目录"/>
                        <TextBlock x:Name="ConfigDirText" Style="{StaticResource SubLabel}" Margin="0,2"/>
                        <Button Content="打开配置目录" Style="{StaticResource FlatButton}" Padding="12,5"
                                Margin="0,10" HorizontalAlignment="Left" Click="OnOpenConfigDir"/>

                        <TextBlock Margin="0,16,0,0" Style="{StaticResource SubLabel}"
                                   Text="用法：点击任务栏图标展开快捷方式菜单；菜单里按住名称可拖动排序，右键单项可重命名或隐藏。"/>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SubLabel}"
                                   Text="图标已经固定在任务栏时会常驻；未固定时随本程序启动出现，右键可随时取消固定。"/>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource SubLabel}" Text="命令行：--startup 静默启动 / --menu / --settings / --exit"/>
                        <TextBlock x:Name="VersionText" Margin="0,10,0,0" Style="{StaticResource SubLabel}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Br.Sep}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="应用" Style="{StaticResource FlatButton}" Padding="18,6" Click="OnApply"/>
                    <Button Content="确定" Style="{StaticResource FlatButton}" Padding="18,6" Margin="10,0,0,0" Click="OnSave"/>
                    <Button Content="取消" Style="{StaticResource FlatButton}" Padding="18,6" Margin="10,0,0,0" Click="OnClose"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
