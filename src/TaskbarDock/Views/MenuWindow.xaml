<Window x:Class="TaskbarDock.Views.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MenuWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="WidthAndHeight"
        MinWidth="200"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">

    <Grid>
        <Border x:Name="Root" Margin="14"
                CornerRadius="10"
                Background="{DynamicResource Br.Menu}"
                BorderBrush="{DynamicResource Br.Border}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.38" Color="#FF000000" Direction="270"/>
            </Border.Effect>

            <ListBox x:Name="List"
                     Style="{StaticResource CleanListBox}"
                     ItemsSource="{Binding Items}"
                     Margin="4"
                     MaxHeight="{Binding MenuMaxHeight}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonDown="OnDown"
                     PreviewMouseMove="OnMove"
                     PreviewMouseLeftButtonUp="OnUp"/>
        </Border>
    </Grid>
</Window>
