<Window x:Class="TaskbarDock.Views.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MenuWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="WidthAndHeight"
        MinWidth="200"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">

    <Grid>
        <Border x:Name="Root" Margin="14"
                CornerRadius="10"
                Background="{DynamicResource Br.Menu}"
                BorderBrush="{DynamicResource Br.Border}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.38" Color="#FF000000" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TitleText}"
                           Margin="14,11,14,7"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Br.Fg2}"
                           TextTrimming="CharacterEllipsis"/>

                <Rectangle Grid.Row="1" Height="1" Margin="8,0" Fill="{DynamicResource Br.Sep}"/>

                <ListBox x:Name="List"
                         Grid.Row="2"
                         Style="{StaticResource CleanListBox}"
                         ItemsSource="{Binding Items}"
                         Margin="2,6,2,4"
                         MaxHeight="{Binding MenuMaxHeight}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonDown="OnDown"
                         PreviewMouseMove="OnMove"
                         PreviewMouseLeftButtonUp="OnUp"/>

                <Border Grid.Row="3" Padding="10,8"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Br.Sep}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="按住名称拖动可排序" VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="11" Foreground="{DynamicResource Br.Fg2}"/>
                        <Button Style="{StaticResource FlatButton}" Content="打开目录" Padding="10,4" FontSize="12" Click="OnOpenFolder"/>
                        <Button Style="{StaticResource FlatButton}" Content="设置" Padding="10,4" FontSize="12" Margin="8,0,0,0" Click="OnSettings"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
