<Window x:Class="TaskbarDock.Views.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MenuWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="WidthAndHeight"
        MinWidth="200"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">

    <Grid>
        <!-- Margin/阴影去掉：DropShadowEffect 在 AllowTransparency 窗口边缘会产生直角轮廓，
             所以这里完全不要外阴影，保持纯圆角卡片。 -->
        <Border x:Name="Root" Margin="0"
                CornerRadius="10"
                Background="{DynamicResource Br.Menu}"
                BorderThickness="0"
                Padding="4"
                ClipToBounds="True"
                SnapsToDevicePixels="True">

            <ListBox x:Name="List"
                     Style="{StaticResource CleanListBox}"
                     ItemsSource="{Binding Items}"
                     Margin="0"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="{Binding MenuMaxHeight}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonDown="OnDown"
                     PreviewMouseMove="OnMove"
                     PreviewMouseLeftButtonUp="OnUp"/>
        </Border>
    </Grid>
</Window>
